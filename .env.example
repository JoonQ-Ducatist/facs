# Supabase public browser configuration. Never commit a populated .env file.
VITE_SUPABASE_URL=
# Preferred browser key. It is public and must still be protected by RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Temporary compatibility alias only; do not set both in a new deployment.
# VITE_SUPABASE_ANON_KEY=

# Public deployment origin and the exact Auth callback URL registered in Supabase.
# Preview and production use separate, fixed HTTPS callback URLs.
VITE_APP_ORIGIN=
VITE_AUTH_REDIRECT_URL=

# Local-only QA account session secret. Do not prefix with VITE_; Vite keeps
# this value in the development server and never sends it to the browser.
FACS_QA_ACCOUNT_PASSWORD=
