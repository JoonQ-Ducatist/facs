{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "preview/facs": true,
      "main": true
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/?locale=en",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": { "re": "^(US|GB|CA|AU|NZ|IE|SG|ZA|IN|PH)$" }
        }
      ],
      "missing": [{ "type": "query", "key": "locale" }],
      "statusCode": 307
    },
    {
      "source": "/",
      "destination": "/?locale=ko",
      "has": [
        {
          "type": "header",
          "key": "x-vercel-ip-country",
          "value": "KR"
        }
      ],
      "missing": [{ "type": "query", "key": "locale" }],
      "statusCode": 307
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
